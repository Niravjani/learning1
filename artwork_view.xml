<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Artwork List View -->
    <record id="view_art_artwork_list" model="ir.ui.view">
        <field name="name">art.artwork.list</field>
        <field name="model">art.artwork</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="artist_name"/>
                <field name="art_type"/>
                <field name="price"/>
                <field name="year_created"/>
                <field name="exhibition_id"/>
            </list>
        </field>
    </record>
    <!-- Artwork Form View -->
    <record id="view_art_artwork_form" model="ir.ui.view">
        <field name="name">art.artwork.form</field>
        <field name="model">art.artwork</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="artist_name"/>
                        <field name="art_type"/>
                    </group>
                    <group>
                        <field name="price"/>
                        <field name="year_created"/>
                        <field name="exhibition_id"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Artwork Search View -->
    <record id="view_art_artwork_search" model="ir.ui.view">
        <field name="name">art.artwork.search</field>
        <field name="model">art.artwork</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="artist_name"/>
                <field name="art_type"/>
                <field name="exhibition_id"/>
                <group>
                    <filter
                        name="group_by_exhibition"
                        string="Exhibition"
                        context="{'group_by': 'exhibition_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <!-- Artwork Action -->
    <record id="action_art_artwork" model="ir.actions.act_window">
        <field name="name">Artworks</field>
        <field name="res_model">art.artwork</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>